#!/usr/bin/env bash
set -Eeuo pipefail

STACK_DIR=/opt/one-shot-n8n
DATA_DIR=/var/lib/one-shot-n8n
BACKUP_DIR=/var/backups/one-shot-n8n
COMPOSE_FILE="$STACK_DIR/compose.yaml"
ENV_FILE="$STACK_DIR/.env"

die() { echo "ERROR: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || die "Run with sudo."
[[ -f "$ENV_FILE" && -f "$COMPOSE_FILE" && -d "$DATA_DIR" ]] || die "n8n installation or data directory is missing."
command -v docker >/dev/null 2>&1 || die "Docker is not installed."
cd "$STACK_DIR"
# shellcheck disable=SC1091
# shellcheck disable=SC1090
source "$ENV_FILE"

latest_stable() {
  curl -fsSL \
    -H 'Accept: application/vnd.github+json' \
    -H 'User-Agent: one-shot-n8n-installer' \
    'https://api.github.com/repos/n8n-io/n8n/releases?per_page=30' |
    python3 -c '
import json, sys
for r in json.load(sys.stdin):
    if not r.get("draft") and not r.get("prerelease"):
        print(r["tag_name"].split("@", 1)[-1].lstrip("v"))
        break
else:
    raise SystemExit("No stable n8n release found")
'
}
valid_version() { [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
[[ ${N8N_VERSION:-} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && -n ${N8N_DOMAIN:-} && -n ${N8N_DATA_DIR:-} ]] || die "Invalid .env file."

target="${1:-}"
if [[ -z $target ]]; then
  echo "Checking latest stable n8n release..."
  target="$(latest_stable)"
fi
valid_version "$target" || die "Invalid n8n version: $target"
if [[ $target == "$N8N_VERSION" ]]; then
  echo "Already running n8n $N8N_VERSION."
  exit 0
fi

old_version="$N8N_VERSION"
stamp="$(date -u +%Y%m%d-%H%M%S)-${BASHPID}"
mkdir -p "$BACKUP_DIR"
chmod 0700 "$BACKUP_DIR"
backup="$BACKUP_DIR/pre-update-${old_version}-${stamp}.tar.gz"
backup_tmp="${backup}.partial.$$"
backup_env="${backup%.tar.gz}.env"
backup_env_tmp="${backup_env}.partial.$$"
failed_state="$BACKUP_DIR/failed-update-${target}-${stamp}.tar.gz"
rollback_stage=""
old_data="${DATA_DIR}.pre-update-${stamp}"
backup_ready=0
restore_old=0

wait_ready() {
  local tries="$1"
  for ((i=0; i<tries; i++)); do
    if curl -fsS --max-time 5 http://127.0.0.1:5678/healthz/readiness >/dev/null 2>&1; then
      return 0
    fi
    sleep 3
  done
  return 1
}

on_exit() {
  rc=$?
  trap - EXIT
  set +e
  rm -f -- "$backup_tmp" "$backup_env_tmp"
  if [[ $restore_old == 1 ]]; then
    if (( backup_ready == 1 )); then
      echo "Update did not complete; attempting data-and-version rollback..." >&2
      docker compose -f "$COMPOSE_FILE" stop n8n >/dev/null 2>&1
      if tar -C "$DATA_DIR" -czf "$failed_state" . 2>/dev/null &&
         tar -tzf "$failed_state" >/dev/null 2>&1; then
        chmod 0600 "$failed_state"
      else
        rm -f -- "$failed_state"
        echo "WARNING: Could not verify a failed-state snapshot; preserving the failed data directory during rollback." >&2
      fi
      rollback_stage="$(mktemp -d "${DATA_DIR}.rollback.XXXXXX")"
      if tar -C "$rollback_stage" -xzf "$backup"; then
        if mv -- "$DATA_DIR" "$old_data" && mv -- "$rollback_stage" "$DATA_DIR"; then
          rollback_stage=""
          chown -R 1000:1000 "$DATA_DIR"
          if cp -- "$backup_env" "$ENV_FILE" &&
             docker compose -f "$COMPOSE_FILE" up -d --force-recreate n8n >/dev/null &&
             wait_ready 60; then
            echo "Rollback succeeded: n8n $old_version is ready." >&2
            echo "Pre-update backup: $backup" >&2
            if [[ -f "$failed_state" ]]; then
              echo "Verified failed-state snapshot: $failed_state" >&2
              rm -rf -- "$old_data"
            else
              echo "Failed-state snapshot unavailable; preserving the old data directory at $old_data." >&2
            fi
          else
            echo "CRITICAL: Rollback was attempted but readiness was not confirmed. Preserve $backup and $old_data; inspect Docker logs before further changes." >&2
            rc=1
          fi
        else
          if [[ ! -e "$DATA_DIR" && -d "$old_data" ]]; then
            mv -- "$old_data" "$DATA_DIR"
          fi
          cp -- "$backup_env" "$ENV_FILE" 2>/dev/null
          echo "CRITICAL: Could not switch back to the pre-update data. A best-effort restart will be attempted; preserve $backup and inspect $DATA_DIR, $old_data, and $rollback_stage." >&2
          docker compose -f "$COMPOSE_FILE" up -d n8n >/dev/null 2>&1
          rc=1
        fi
      else
        cp -- "$backup_env" "$ENV_FILE" 2>/dev/null
        echo "CRITICAL: Could not extract the verified pre-update backup. A best-effort restart will be attempted; preserve $backup and inspect the host." >&2
        docker compose -f "$COMPOSE_FILE" up -d n8n >/dev/null 2>&1
        rc=1
      fi
    else
      docker compose -f "$COMPOSE_FILE" start n8n >/dev/null 2>&1 || {
        echo "CRITICAL: Update stopped before a verified backup existed and n8n could not be restarted." >&2
        rc=1
      }
    fi
  fi
  [[ -z $rollback_stage ]] || rm -rf -- "$rollback_stage"
  exit "$rc"
}
trap on_exit EXIT

echo "Current version: $old_version"
echo "Target version:  $target"
echo
read -r -p "Continue with backup + update? [y/N] " answer
[[ $answer =~ ^[Yy]$ ]] || { echo "Cancelled."; exit 0; }

echo "Pulling n8n $target image before downtime..."
N8N_VERSION="$target" docker compose -f "$COMPOSE_FILE" pull n8n >/dev/null

echo "Stopping n8n for a consistent SQLite backup..."
docker compose -f "$COMPOSE_FILE" stop n8n
restore_old=1

echo "Creating and verifying pre-update backup..."
tar -C "$DATA_DIR" -czf "$backup_tmp" .
tar -tzf "$backup_tmp" >/dev/null || die "Pre-update backup verification failed; update aborted."
cp -- "$ENV_FILE" "$backup_env_tmp"
chmod 0600 "$backup_tmp" "$backup_env_tmp"
mv -- "$backup_tmp" "$backup"
mv -- "$backup_env_tmp" "$backup_env"
backup_ready=1

echo "Switching to n8n $target..."
sed -i -E "s/^N8N_VERSION=.*/N8N_VERSION=$target/" "$ENV_FILE"
docker compose -f "$COMPOSE_FILE" up -d --force-recreate n8n >/dev/null

echo "Waiting for database migrations/readiness..."
wait_ready 100 || die "n8n $target failed readiness; automatic rollback will run."

restore_old=0
echo
echo "n8n updated successfully: $old_version -> $target"
echo "Verified pre-update backup: $backup"
echo "Backup metadata: $backup_env"
docker image rm "n8nio/n8n:$old_version" >/dev/null 2>&1 || true
